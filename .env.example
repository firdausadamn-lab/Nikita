# ---------------------------------------------------------------------------
# The Wrestler's Home — environment. Copy to .env.local and fill in.
# Set the same values in Netlify: Site configuration > Environment variables.
# ---------------------------------------------------------------------------

# Public site URL. Used for absolute links, OG images, and — importantly — to
# build the password-reset link Supabase emails out. Get this wrong in
# production and reset emails point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Accounts ---------------------------------------------------------------
# Access codes are one-time tickets: redeeming one creates a single account and
# spends the code. From then on the athlete signs in with email and password.
#
# All of these are in Supabase: Project settings > API.

# SERVER-SIDE ONLY. The service role key bypasses row level security, so
# exposing it to the browser would hand a visitor full read/write access to the
# database. Never rename either of these to NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safe to expose. The anon key grants nothing on its own — access_codes has RLS
# on with zero policies — and it is what lets Supabase Auth issue and refresh
# sessions. The middleware needs these two under exactly these NEXT_PUBLIC_
# names, because that is what makes them readable at the edge.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ACCESS_COOKIE_SECRET is gone. It signed the old shareable access cookie,
# which no longer exists — sessions are Supabase's now. Delete it from Netlify.

# --- Course video host (EMBED ONLY, never self-host video) ------------------
# Decide {{VIDEO_HOST}}: Vimeo | Bunny | YouTube-unlisted, then set the host.
NEXT_PUBLIC_VIDEO_HOST=

# --- Contact ----------------------------------------------------------------
SUPPORT_EMAIL=
